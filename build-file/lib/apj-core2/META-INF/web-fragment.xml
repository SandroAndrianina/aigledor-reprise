<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    <name>apjconfig</name>
    <servlet>
        <servlet-name>Deroulante</servlet-name>
        <servlet-class>web.servlet.Deroulante</servlet-class>
    </servlet>
     <servlet>
        <servlet-name>AutoComplete</servlet-name>
        <servlet-class>web.servlet.AutoComplete</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ServletDownload</servlet-name>
        <servlet-class>web.servlet.ServletDownload</servlet-class>
    </servlet>
	<servlet>
        <servlet-name>ImportUtilServlet</servlet-name>
        <servlet-class>web.importController.ImportUtilServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UploadFile</servlet-name>
        <servlet-class>web.upload.UploadFile</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>KanbanUpdateServlet</servlet-name>
        <servlet-class>web.servlet.KanbanUpdateServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>KanbanDupliqueCardServlet</servlet-name>
        <servlet-class>web.servlet.KanbanDupliqueCardServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>KanbanRemoveServlet</servlet-name>
        <servlet-class>web.servlet.KanbanRemoveServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Evaluation</servlet-name>
        <servlet-class>web.servlet.AiEvaluationServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CalendrierData</servlet-name>
        <servlet-class>web.servlet.CalendrierDataServlet</servlet-class>
    </servlet>
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>web.servlet.EncodingFilter</filter-class>
    </filter>
    <servlet>
        <servlet-name>CalendrierServlet</servlet-name>
        <servlet-class>web.servlet.CalendrierServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DeletePJ</servlet-name>
        <servlet-class>web.servlet.DeletePj</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>Deroulante</servlet-name>
        <url-pattern>/Deroulante</url-pattern>
    </servlet-mapping>
	
	<servlet-mapping>
        <servlet-name>ServletDownload</servlet-name>
        <url-pattern>/download</url-pattern>
    </servlet-mapping>
	
	<servlet-mapping>
        <servlet-name>ImportUtilServlet</servlet-name>
        <url-pattern>/ImportUtilServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AutoComplete</servlet-name>
        <url-pattern>/autocomplete</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>UploadFile</servlet-name>
        <url-pattern>/upload_excel</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>KanbanUpdateServlet</servlet-name>
        <url-pattern>/kanban/update</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>KanbanDupliqueCardServlet</servlet-name>
        <url-pattern>/kanban/duplique</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>KanbanRemoveServlet</servlet-name>
        <url-pattern>/kanban/remove</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>Evaluation</servlet-name>
        <url-pattern>/ai-evaluation</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>CalendrierData</servlet-name>
        <url-pattern>/calendrier-data</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CalendrierServlet</servlet-name>
        <url-pattern>/calendrier</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeletePJ</servlet-name>
        <url-pattern>/DeletePj</url-pattern>
    </servlet-mapping>

    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
	

    <!-- Add more servlet configurations as needed -->

</web-app>